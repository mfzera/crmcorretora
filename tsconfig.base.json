{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "./libs/shared/types/src"],
    "paths": {
      "@ecotech/shared/types": ["libs/shared/types/src/index.ts"],
      "@ecotech/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@ecotech/shared/utils/env": ["libs/shared/utils/src/env.ts"],
      "@ecotech/shared/utils/logger": ["libs/shared/utils/src/logger.ts"],
      "@ecotech/shared/utils/api-helpers": [
        "libs/shared/utils/src/api-helpers.ts",
      ],
      "@ecotech/shared/utils/email.service": [
        "libs/shared/utils/src/email.service.ts",
      ],
      "@ecotech/shared/config": ["libs/shared/config/src/index.ts"],
      "@ecotech/shared/database": ["libs/shared/database/src/index.ts"],
      "@ecotech/shared/domain": ["libs/shared/domain/src/index.ts"],
      "@ecotech/plugins/auth": ["libs/plugins/auth/src/index.ts"],
      "@ecotech/plugins/authorization": [
        "libs/plugins/authorization/src/index.ts",
      ],
      "@ecotech/plugins/chat": ["libs/plugins/chat/src/index.ts"],
      "@ecotech/plugins/tenant-isolation": [
        "libs/plugins/tenant-isolation/src/index.ts",
      ],
      "@ecotech/plugins/quota-validator": [
        "libs/plugins/quota-validator/src/index.ts",
      ],
      "@ecotech/plugins/error-handler": [
        "libs/plugins/error-handler/src/index.ts",
      ],
      "@ecotech/plugins/admin-auth": ["libs/plugins/admin-auth/src/index.ts"],
      "@ecotech/shared/storage": ["libs/shared/storage/src/index.ts"],
      "@ecotech/features/auth": ["libs/features/auth/src/index.ts"],
      "@ecotech/features/usuarios": ["libs/features/usuarios/src/index.ts"],
      "@ecotech/features/vendedores": ["libs/features/vendedores/src/index.ts"],
      "@ecotech/features/cargos": ["libs/features/cargos/src/index.ts"],
      "@ecotech/features/equipes": ["libs/features/equipes/src/index.ts"],
      "@ecotech/features/clientes": ["libs/features/clientes/src/index.ts"],
      "@ecotech/features/produtos": ["libs/features/produtos/src/index.ts"],
      "@ecotech/features/cotacoes": ["libs/features/cotacoes/src/index.ts"],
      "@ecotech/features/propostas": ["libs/features/propostas/src/index.ts"],
      "@ecotech/features/documentos-venda": [
        "libs/features/documentos-venda/src/index.ts",
      ],
      "@ecotech/features/endossos": ["libs/features/endossos/src/index.ts"],
      "@ecotech/features/renovacoes": ["libs/features/renovacoes/src/index.ts"],
      "@ecotech/features/dashboard": ["libs/features/dashboard/src/index.ts"],
      "@ecotech/features/seguradora": ["libs/features/seguradora/src/index.ts"],
      "@ecotech/features/seguradoras-parceiras": [
        "libs/features/seguradoras-parceiras/src/index.ts",
      ],
      "@ecotech/ui": ["libs/shared/ui/src/index.ts"],
    },
  },
  "exclude": ["node_modules", "tmp"],
}
