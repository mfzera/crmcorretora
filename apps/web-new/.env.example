# URL da API backend
VITE_API_URL=https://api.ecotechts.com.br/api

# URL pública do frontend
VITE_APP_URL=https://ecotechts.com.br

# URL do storage de arquivos
VITE_STORAGE_URL=https://storage.ecotechts.com.br

# Chave pública do reCAPTCHA v2 (obrigatória para o captcha no login aparecer)
VITE_RECAPTCHA_SITE_KEY=

# URL da plataforma de treinamentos (opcional)
VITE_TREINAMENTOS_URL=

# Sentry (opcional — deixar vazio para desativar)
VITE_SENTRY_DSN=
# Taxa de amostragem de traces/Web Vitals (0..1). Vazio = 0.2 em produção.
# Subir temporariamente (ex.: 0.5) durante janelas de diagnóstico de performance.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Modo manutenção — bloqueia todos os usuários com tela de manutenção
# Valores: true | false (ou deixar vazio = false)
VITE_MAINTENANCE=false
