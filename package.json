{
  "name": "ecotech2-monorepo",
  "version": "1.0.1",
  "description": "SaaS Multi-Tenant para Seguradoras - Sistema Completo de Gestão de Vendas",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm exec nx run-many --target=dev --projects=api,web-new --parallel",
    "dev:api": "pnpm exec nx dev api",
    "dev:web": "pnpm exec nx dev web-new",
    "dev:mcp": "pnpm exec nx dev mcp-server",
    "build:mcp": "pnpm exec nx build mcp-server",
    "start:mcp": "node dist/apps/mcp-server/main.js",
    "build": "pnpm exec nx build api",
    "build:web": "pnpm exec nx build web-new",
    "build:all": "pnpm exec nx run-many --target=build --all",
    "start": "node dist/apps/api/main.js",
    "test": "pnpm exec nx run-many --target=test --all",
    "lint": "pnpm exec nx run-many --target=lint --all",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "tsx apps/api/scripts/run-migrations.ts",
    "db:migrate:kit": "pnpm exec drizzle-kit migrate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:studio": "pnpm exec drizzle-kit studio",
    "db:seed": "tsx libs/shared/database/src/seed.ts",
    "db:backfill-cotacoes": "tsx libs/shared/database/src/backfill-cotacoes-oportunidades.ts",
    "admin:create": "tsx scripts/create-admin-user.ts",
    "deploy:migrate": "tsx apps/api/scripts/run-migrations.ts",
    "nx:graph": "pnpm exec nx graph",
    "test:e2e": "pnpm exec nx test-e2e api",
    "test:e2e:watch": "pnpm exec nx test-e2e api --configuration=watch",
    "test:e2e:coverage": "pnpm exec nx test-e2e api --configuration=coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/fastify-api-reference": "^1.52.5",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.53.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "patchedDependencies": {
      "zod@4.3.6": "patches/zod@4.3.6.patch",
      "react-google-recaptcha@2.1.0": "patches/react-google-recaptcha@2.1.0.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "^22.6.5",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.3.3",
    "@nx/node": "^22.6.5",
    "@nx/workspace": "22.3.3",
    "@types/node": "22.19.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "jsonc-eslint-parser": "^3.1.0",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
